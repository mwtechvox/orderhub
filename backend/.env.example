DJANGO_SECRET_KEY=replace-with-random-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://orderhub:orderhub@postgres:5432/orderhub
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
# Comma-separated additional browser origins trusted for CSRF, for example the
# local Next server when a public frontend tunnel proxies its API requests.
CSRF_TRUSTED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_FACEBOOK_REDIRECT_URI=http://localhost:8000/api/meta/facebook/callback/
TOKEN_ENCRYPTION_KEY=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
